# Compiled binaries from `deno task compile`
/target/

# Built javascript and application
/dist/

# Dependencies installed locally instead of the global deno cache
node_modules/

# Coverage output from `deno test --coverage`
coverage/


# Tmp
/tmp/*
!tmp/.gitkeep

saves/*

# Docusaurus docs site (site/): build output and cache
site/build/
site/.docusaurus/
# Example sources copied here at build time to serve as downloads
site/static/downloads/
# site/node_modules/ is already covered by the node_modules/ rule above
