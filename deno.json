{
  "name": "@berkes/vormen",
  "version": "0.2.0",
  "description": "Vormen is a bag of tools, modules and scripts for creating generative art in SVG using Javascript",
  "exports": {
    ".": "./src/vormen.ts",
    "./runner": "./src/vormen/vormen.ts"
  },
  "workspace": ["./examples"],
  "tasks": {
    "test": "deno test --allow-net --allow-read --allow-run --allow-write",
    "check:all": "deno ci && deno check && deno lint && deno fmt --check && deno test --allow-net --allow-read --allow-run --allow-write"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@svgdotjs/svg.js": "npm:@svgdotjs/svg.js@^3.2.8",
    "alea": "npm:alea@^1.0.1",
    "simplex-noise": "npm:simplex-noise@^4.0.3",
    "svgdom": "npm:svgdom@^0.1.29"
  },
  "compile": {
    "include": []
  },
  "fmt": {
    "exclude": [
      "doc/glossary.md"
    ]
  },
  "exclude": ["target/", "dist/", "saves/"]
}
