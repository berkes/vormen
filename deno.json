{
  "name": "@berkes/vormen",
  "version": "1.0.4",
  "description": "Vormen is a bag of tools, modules and scripts for creating generative art in SVG using Javascript",
  "exports": "./src/vormen/index.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net src/cli/server.ts",
    "render": "deno run --allow-read --allow-write src/cli/render.ts",
    "test": "deno test --allow-net --allow-read --allow-run",
    "check:all": "deno ci && deno check && deno lint && deno fmt --check && deno test --allow-run"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@svgdotjs/svg.js": "npm:@svgdotjs/svg.js@^3.2.8",
    "alea": "npm:alea@^1.0.1",
    "simplex-noise": "npm:simplex-noise@^4.0.3"
  },
  "compile": {
    "include": ["src/cli/server.ts", "src/cli/render.ts"]
  }
}
